<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse">
    <!-- 4 ms step (Gazebo default is 1 ms): /clock is published every step, and at 1 kHz the
         Python nodes on sim time (sun_sensor, sun_brain, plant_monitor) used ~80 % CPU each -->
    <physics name="4ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <!-- Lighting is only for looking at the scene. The simulated sun (sun_sensor, RViz) cannot
         be shown by a Gazebo light: Fortress cannot move lights at runtime. So this lamp casts
         no shadows (no fake, fixed "sun patch" through a window) and the room is lit evenly. -->
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="room_light">
      <cast_shadows>false</cast_shadows>
      <direction>-0.3 0.2 -1.0</direction>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></visual>
    </link></model>
    <model name="warehouse"><static>true</static>
      <link name="east_side0">
        <pose>10.0 -3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="east_side1">
        <pose>10.0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="east_sill">
        <pose>10.0 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="east_lintel">
        <pose>10.0 0 2.6 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.0 0.7999999999999998</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 0.7999999999999998</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="south_side0">
        <pose>-5.5 -6.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9.0 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9.0 0.2 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="south_side1">
        <pose>5.5 -6.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>9.0 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>9.0 0.2 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="south_sill">
        <pose>0 -6.0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="south_lintel">
        <pose>0 -6.0 2.6 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.0 0.2 0.7999999999999998</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.2 0.7999999999999998</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="west_side0">
        <pose>-10.0 -3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="west_side1">
        <pose>-10.0 3.5 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 5.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5.0 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="west_sill">
        <pose>-10.0 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 1.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="west_lintel">
        <pose>-10.0 0 2.6 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 2.0 0.7999999999999998</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 0.7999999999999998</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="north">
        <pose>0 6.0 1.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.2 0.2 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 3.0</size></box></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
      <link name="roof">
        <pose>0 0 3.05 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.2 12.2 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 12.2 0.1</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
      <link name="pallet0">
        <pose>-4 2 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
      <link name="pallet1">
        <pose>3 3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
      <link name="pallet2">
        <pose>5 -2 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
      <link name="pallet3">
        <pose>-6 -3 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.0 1.0</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse><ambient>0.6 0.4 0.2 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>